rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // -------------------------------------------------------------------------
    // 1. PRIMITIVES & HELPERS
    // -------------------------------------------------------------------------
    
    function isSignedIn() { return request.auth != null; }
    function isOwner(ownerId) { return isSignedIn() && request.auth.uid == ownerId; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function isAdmin() {
      // NOTE: We use a dedicated admins collection for role lookup to avoid recursion 
      // or reliance on user profiles which they might control.
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // -------------------------------------------------------------------------
    // 2. VALIDATION BLUEPRINTS
    // -------------------------------------------------------------------------

    function isValidUser(data) {
      let requiredKeys = ['uid', 'email', 'createdAt', 'updatedAt'];
      let optionalKeys = ['displayName', 'photoURL', 'role'];
      return data.keys().hasAll(requiredKeys) &&
             data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time &&
             (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 100)) &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500)) &&
             (!('role' in data) || (data.role in ['admin', 'user']));
    }

    function isValidModule(data) {
      let requiredKeys = ['id', 'name', 'fields', 'createdBy', 'createdAt', 'icon'];
      let optionalKeys = ['description'];
      return data.keys().hasAll(requiredKeys) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.fields is list && data.fields.size() > 0 && data.fields.size() <= 20 &&
             data.createdBy == request.auth.uid &&
             data.createdAt == request.time &&
             data.icon is string &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000));
    }

    function isValidItem(data) {
      // Dynamic items - minimal validation for keys, but enforce ownership fields if needed
      // Actually these items are schema-less from Firestore's perspective here,
      // but we enforce server metadata.
      return data.keys().hasAll(['createdAt', 'updatedAt']) &&
             data.createdAt == request.time &&
             data.updatedAt == request.time;
    }

    function isValidTask(data) {
      let requiredKeys = ['title', 'ownerId', 'createdAt', 'updatedAt', 'status', 'priority'];
      let optionalKeys = ['description'];
      return data.keys().hasAll(requiredKeys) &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.ownerId == request.auth.uid &&
             data.status in ['todo', 'in-progress', 'done'] &&
             data.priority in ['low', 'medium', 'high'] &&
             data.createdAt == request.time &&
             data.updatedAt == request.time &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    function isValidProject(data) {
      let requiredKeys = ['id', 'name', 'ownerId', 'createdAt', 'updatedAt', 'moduleIds'];
      let optionalKeys = ['description'];
      return data.keys().hasAll(requiredKeys) &&
             isValidId(data.id) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 200 &&
             data.ownerId == request.auth.uid &&
             data.moduleIds is list && data.moduleIds.size() <= 50 &&
             data.createdAt == request.time &&
             data.updatedAt == request.time &&
             (!('description' in data) || (data.description is string && data.description.size() <= 2000));
    }

    // -------------------------------------------------------------------------
    // 3. ACCESS RULES
    // -------------------------------------------------------------------------

    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId) && isValidUser(incoming());
      allow update: if isOwner(userId) && (
        // Protect role from self-assignment
        incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'updatedAt']) &&
        incoming().updatedAt == request.time
      );
    }

    match /modules/{moduleId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidModule(incoming());
      allow update: if isOwner(existing().createdBy) && isValidModule(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'fields', 'description', 'updatedAt', 'icon']) &&
        incoming().updatedAt == request.time &&
        incoming().createdBy == existing().createdBy &&
        incoming().id == existing().id &&
        incoming().createdAt == existing().createdAt
      );
      allow delete: if isOwner(existing().createdBy) || isAdmin();

      // Sub-collection for dynamic items
      match /items/{itemId} {
        function canAccessParentModule(modId) {
          // get() bypasses security rules, so we check the data
          let parent = get(/databases/$(database)/documents/modules/$(modId));
          return parent.data.createdBy == request.auth.uid;
        }

        allow read, list: if isSignedIn() && (canAccessParentModule(moduleId) || isAdmin());
        allow create: if isSignedIn() && (canAccessParentModule(moduleId) || isAdmin()) && isValidItem(incoming());
        allow update: if isSignedIn() && (canAccessParentModule(moduleId) || isAdmin()) && isValidItem(incoming()) && (
          incoming().diff(existing()).affectedKeys().hasOnly(['updatedAt']) || // Add other fields as needed
          // For simplicity in dynamic modules, we allow all fields EXCEPT metadata ones to be changed
          !incoming().diff(existing()).affectedKeys().hasAny(['createdAt']) &&
          incoming().updatedAt == request.time
        );
        allow delete: if isSignedIn() && (canAccessParentModule(moduleId) || isAdmin());
      }
    }

    match /tasks/{taskId} {
      allow read, list: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isSignedIn() && isValidTask(incoming());
      allow update: if isOwner(existing().ownerId) && isValidTask(incoming()) && (
        (
          // Action: Toggle Status
          incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt'])
        ) || (
          // Action: Edit Full Task
          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'status', 'updatedAt'])
        )
      ) && 
      incoming().updatedAt == request.time &&
      incoming().ownerId == existing().ownerId &&
      incoming().createdAt == existing().createdAt;
      
      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }

    match /projects/{projectId} {
      allow read, list: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isSignedIn() && isValidProject(incoming());
      allow update: if isOwner(existing().ownerId) && isValidProject(incoming()) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'description', 'moduleIds', 'updatedAt'])
      ) && 
      incoming().updatedAt == request.time &&
      incoming().ownerId == existing().ownerId &&
      incoming().id == existing().id &&
      incoming().createdAt == existing().createdAt;
      
      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, list: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing().ownerId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['status', 'bankInfo', 'mobileWalletInfo', 'email', 'mobile', 'shopName', 'updatedAt'])
      );
      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }

    match /products/{productId} {
      allow read, list: if isOwner(resource.data.ownerId) || isAdmin();
      allow create: if isSignedIn() && incoming().ownerId == request.auth.uid;
      allow update: if isOwner(existing().ownerId) && (
        incoming().diff(existing()).affectedKeys().hasOnly(['name', 'stock', 'cpu', 'mrp', 'variants', 'status', 'updatedAt'])
      );
      allow delete: if isOwner(existing().ownerId) || isAdmin();
    }
    
    // Admin collection - only for manual bootstrap or via special cloud functions (not in this scope)
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false; // Only manageable via console
    }
  }
}
